; Emberclutch valley ground: the static program (static.v.pica) plus a texture coordinate.
;   * The same inputs and uniforms as static.v.pica, in the same order (so the same
;     registers: render3d checks it), and the same colour.
;   * A texture coordinate from the position (run 19: the valley's ground takes a detail
;     texture this way, with no more triangles): u = detailU . pos, v = detailV . pos.
;   * Its own program since run 21 (D107): with it the den's room froze on the hardware,
;     so everything else draws with the static program, which has no texture output. The
;     valley then froze on its first frame (D108): the output is now written whole.
; Uniform budget: 4 + 4 + 1 + 1 + 2 + 1 constant = 13 of 96 float registers.

.fvec projection[4], modelView[4]
.fvec blend  ; x: weight of set B
.fvec tint   ; rgba multiplier / 255
.fvec detailU, detailV  ; xyz: the position's weights for the texture coordinate

.constf consts(1.0, 0.0, 0.0, 0.0)
.alias  ones consts.xxxx

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0  ; float x3, den space
.alias inA   v1  ; ubyte x4: colour in lighting set A
.alias inB   v2  ; ubyte x4: colour in lighting set B

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; (every component of the output written, with one mov, as the dragon's and citro2d's
	; shaders do: the valley froze on its first frame with x and y written apart, run 21)
	mov r4, consts.yyyx
	dp3 r4.x, detailU, r0
	dp3 r4.y, detailV, r0
	mov outtc0, r4

	; one instruction reads at most one input register
	mov r3, inA
	add r2, inB, -r3
	mad r2, r2, blend.xxxx, r3
	mul outclr, tint, r2
	end
.end
